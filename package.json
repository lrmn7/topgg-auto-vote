{
  "name": "topgg-typescript",
  "version": "1.0.0",
  "description": "Automated multi-account Top.gg voting bot in TypeScript with queue delays, Discord reporting, and JSON database",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:once": "node dist/index.js --once",
    "dev": "ts-node src/index.ts",
    "dev:once": "ts-node src/index.ts --once",
    "start:prod": "npm run build && npm run start"
  },
  "keywords": [
    "topgg",
    "vote",
    "discord",
    "automation",
    "typescript",
    "puppeteer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.1",
    "puppeteer-real-browser": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
