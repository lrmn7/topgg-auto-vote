# ==========================================
# Top.gg Auto-Vote TypeScript Configuration
# ==========================================

# Bot ID(s) on Top.gg separated by commas (supports multiple bots)
BOT_IDS=928711702596423740

# Discord Webhook URL for vote status notifications & error alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/here

# Send error screenshots to Discord on failure (1 = Yes, 0 = No)
SEND_ERROR_SCREENSHOTS=0

# Debug logging in console (1 = Yes, 0 = No)
DEBUG=0

# Queue Timing (Anti-Ban Safe Delays)
# Random delay between accounts in seconds (default: 120s to 180s, i.e., 2 - 3 minutes)
ACCOUNT_DELAY_MIN=120
ACCOUNT_DELAY_MAX=180

# Delay between voting for multiple bots on the same account in seconds (default: 60s)
BOT_DELAY=60

# Browser Headless mode (true for background / VPS / Actions / Pterodactyl, false to watch GUI locally)
HEADLESS=true

# Optional Residential / Datacenter Proxy (to bypass Cloudflare Turnstile on VPS / Pterodactyl)
# Supported formats: http://user:pass@host:port or http://host:port or socks5://host:port
# PROXY_URL=http://username:password@123.45.67.89:8080

# Custom Chrome or Chromium executable path (Optional - auto-detected if left blank)
# Common paths: /usr/bin/chromium, /usr/bin/google-chrome-stable, C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=


